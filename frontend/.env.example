# ClauseGate is pinned to the GenLayer Bradbury testnet through the SDK chain
# object (genlayer-js chains.testnetBradbury). These values are asserted against
# the SDK at runtime; an inconsistent combination fails closed rather than
# silently falling back to Studionet.

# Bradbury RPC. Optional override — accepted ONLY if it is a Bradbury RPC host
# (rpc-bradbury.genlayer.com). Anything else is refused. Leave unset to use the
# pinned default.
# NEXT_PUBLIC_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# GenLayer Bradbury network constants (informational; the SDK chain is authoritative)
# Chain ID: 4221 (0x107d) · Symbol: GEN · Name: GenLayer Bradbury Testnet

# Current ClauseGate v2 production contract on GenLayer Bradbury (chain 4221).
NEXT_PUBLIC_CONTRACT_ADDRESS=0x25F2c44F55b597B9124Af414F991F1aE68913dBa

# Explicit production contract interface selection.
NEXT_PUBLIC_CLAUSEGATE_CONTRACT_VERSION=2
